# Generated by `go tool templ generate` - except under example/, where the
# generated files are checked in: the examples are part of the published
# module, so they must build for a `go get` (and for CI) without the templ
# CLI. Regenerate with `make generate` after editing a .templ file.
*_templ.go
!/example/**/*_templ.go

# Test and coverage output.
*.out
coverage.*
*.test

# `go build ./example/...` drops a binary named after the package directory,
# in whatever directory it was run from. The Makefile only ever uses `go
# run`, so any of these is a stray.
/site
/counter
/example/site/site
/example/counter/counter

# Generated by `make site/css`: loom.css is cmd/css's output, styles.css the
# compiled sheet. input.css next to them is hand-written and belongs here.
/example/site/css/loom.css
/example/site/static/styles.css

# Editor and agent state that is one person's, not the repository's.
.claude/settings.local.json
